            "from",
            "to"
          ],
          "properties": {
            "from": {
              "type": "number"
            },
            "to": {
              "type": "number"
            }
          }
        },
        "first_time": {
          "type": "number"
        },
        "last_time": {
          "type": "number"
        },
        "change_pct": {
          "type": [
            "string",
            "null"
          ]
        },
        "last_5_bars": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#ohlcvBar"
          },
          "maxItems": 5
        }
      },
      "not": {
