{
  "type": "object",
  "required": [
    "bar_count",
    "symbol",
    "resolution",
    "timeframe",
    "source",
    "source_category",
    "requires_desktop",
    "non_mutating",
    "chart_context",
    "returned_bars_range",
    "selected_chart_range_match"
  ],
  "properties": {
    "bar_count": {
      "type": "integer",
      "minimum": 1
